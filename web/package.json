{
  "name": "@engage-mt/web",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "description": "Engage MT web app — React + Vite + TypeScript + ArcGIS Maps SDK + Calcite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-serve-config.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:csp-allowlist": "node scripts/check-csp-allowlist.mjs",
    "check:manifest": "node ../scripts/qc/manifest-audit.mjs",
    "check:stubs": "node ../scripts/qc/stub-registry-audit.mjs",
    "check:units": "node scripts/check-imperial-units.mjs",
    "build:data": "node --experimental-strip-types --no-warnings ../scripts/build-data/build_all.mjs && npm run data:provenance",
    "data:provenance": "node ../scripts/build-data/annotate-provenance.mjs",
    "data:regs": "node ../scripts/build-data/build_regs_snapshot.mjs",
    "preview": "vite preview",
    "start": "serve dist --listen ${PORT:-3000} --single --no-clipboard --cors",
    "lint": "eslint . --max-warnings=0 && npm run lint:css && npm run check:format && npm run check:units",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "check:format": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "calcite:assets": "node scripts/copy-calcite-assets.mjs",
    "postinstall": "npm run calcite:assets",
    "check:calcite-assets": "node scripts/copy-calcite-assets.mjs --check"
  },
  "dependencies": {
    "@arcgis/core": "^5.0.19",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/camera": "8.2.0",
    "@capacitor/core": "8.4.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@esri/calcite-components": "^5.1.0",
    "@esri/calcite-components-react": "^5.1.0",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@axe-core/react": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.7",
    "axe-core": "^4.11.4",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.0.0",
    "happy-dom": "^20.9.0",
    "prettier": "3.8.3",
    "serve": "^14.2.6",
    "stylelint": "^17.13.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.7"
  }
}
