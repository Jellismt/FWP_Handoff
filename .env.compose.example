# Engage MT local parity stack (docker-compose.yml) — copy to .env.compose and edit.
# The compose file has safe inline dev defaults, so `npm run stack:up` works with
# NO file at all. Set these to override for a more prod-like run.

# --- Postgres (tabular regs DB) ---------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=regs

# --- Regs API ---------------------------------------------------------------
# Signs staff session cookies. In prod use a long random value:
#   openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-32ch

# Comma-separated origins allowed to call the public read API (the local web).
PUBLIC_CORS_ORIGINS=http://localhost:8088

# First-boot staff admin (seeded only when staff_user is empty; forced reset on
# first login). Remove/rotate after first real login.
SEED_ADMIN_EMAIL=admin@fwp.mt.gov
SEED_ADMIN_PASSWORD=dev-admin-password-change-me
