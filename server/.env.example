# FWP Regs Manager — server env template. Copy to .env for local dev; on Railway,
# set these in the service Variables (DATABASE_URL is injected by the Postgres plugin).

# Postgres connection string (Railway Postgres plugin injects this).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/regs

# Long random string — signs session cookies. Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated origins allowed to call the PUBLIC read API. Includes the web
# origin, dev, AND the Capacitor WebView origins so the MOBILE app can fetch regs
# live when online (https://localhost = Android, capacitor://localhost = iOS).
# Per ADR-0072 (mobile regs live-when-online, bundle = offline floor).
PUBLIC_CORS_ORIGINS=https://engage-montana.up.railway.app,http://localhost:5173,https://localhost,capacitor://localhost

# Optional: comma-separated IPs and CIDR ranges allowed to reach /api/v1/staff
# routes (IPv4/IPv6, e.g. 203.0.113.0/24,2001:db8::/32). Empty = disabled.
STAFF_IP_ALLOWLIST=

# First-boot admin (used once, when staff_user is empty; then remove).
SEED_ADMIN_EMAIL=admin@fwp.mt.gov
SEED_ADMIN_PASSWORD=change-me-min-14-chars

# Set to 1 on a Postgres WITHOUT the PostGIS extension (skips the geometry sidecars).
SKIP_POSTGIS=

PORT=8080
# MUST be `production` in any hosted deploy: it enables Postgres TLS (managed
# databases like Railway require it) plus production logging + rate-limit posture.
# Leaving it unset defaults to `development`, which disables DB TLS.
NODE_ENV=production
