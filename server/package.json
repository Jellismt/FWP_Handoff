{
  "name": "@engage-mt/regs-server",
  "version": "1.0.0",
  "description": "FWP Regs Manager API — staff CRUD + public read API for DEA hunting regulations (Postgres/Railway, Oracle-portable).",
  "author": "Jamie Ellis",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "seed": "tsx src/db/seed.ts",
    "etl:phase-a": "tsx src/etl/loadDeaJson.ts",
    "sync:districts": "tsx src/etl/syncDistrictCodes.ts",
    "etl:portions": "tsx src/etl/syncPortions.ts",
    "etl:rekey-portions": "tsx src/etl/rekeyPortions.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:server": "bash scripts/test-with-db.sh",
    "lint": "eslint 'src/**/*.ts'",
    "etl:fees-content": "tsx src/etl/loadFeesContent.ts",
    "etl:sunrise-sunset": "tsx src/etl/loadSunriseSunset.ts",
    "etl:sunrise-sunset-grid": "tsx src/etl/loadSunriseSunsetGrid.ts",
    "etl:restricted-areas": "tsx src/etl/loadRestrictedAreas.ts",
    "etl:region-maps": "tsx src/etl/loadRegionMaps.ts",
    "etl:multi-district": "tsx src/etl/loadMultiDistrict.ts",
    "etl:antelope": "tsx src/etl/loadAntelope.ts",
    "etl:important-dates": "tsx src/etl/loadImportantDates.ts",
    "etl:contacts": "tsx src/etl/loadContacts.ts",
    "etl:pamphlet-content": "tsx src/etl/loadPamphletContent.ts",
    "etl:pamphlet-assets": "tsx src/etl/loadPamphletAssets.ts",
    "audit:book": "tsx src/etl/auditBook.ts",
    "verify:gis": "node scripts/verify-gis-layers.mjs",
    "db:backup": "tsx src/ops/backupCli.ts",
    "db:restore-rehearsal": "tsx src/ops/restoreRehearsalCli.ts"
  },
  "dependencies": {
    "@engage-mt/regs-shared": "*",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@node-rs/argon2": "^2.0.0",
    "fastify": "^5.1.0",
    "pg": "^8.13.0",
    "puppeteer-core": "^25.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.7"
  }
}
