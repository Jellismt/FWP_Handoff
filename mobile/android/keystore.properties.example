# Q.23.P1.4 — Android release-signing config template.
#
# Copy this file to `mobile/android/keystore.properties` (gitignored)
# and fill in the four values. The release `build.gradle` reads them
# at build time via `Properties().load(...)` so the build never sees
# the cleartext secrets in environment variables (those leak into
# /proc/<pid>/environ).
#
# Generate the keystore once (the easy way — also writes this file for you):
#   bash mobile/scripts/gen-keystore.sh
#
# CI does NOT sign by default — signed builds are local-only per ADR-0050. If
# you ever opt into CI signing, the workflow would write this file from a repo
# secret (e.g. `echo "${{ secrets.KEYSTORE_PROPERTIES }}" >
# mobile/android/keystore.properties`) before `./gradlew bundleRelease`.

storeFile=app/engagemt.keystore
storePassword=replace-with-your-store-password
keyAlias=engagemt
keyPassword=replace-with-your-key-password
