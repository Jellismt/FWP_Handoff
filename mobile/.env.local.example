# iOS release-signing config template.
#
# Copy this file to `mobile/.env.local` (gitignored) and fill in the three
# values. `bash mobile/scripts/release-ios.sh` sources it to drive the
# xcodebuild archive — the build never sees these in committed source.
#
#   cp mobile/.env.local.example mobile/.env.local
#
# Where each value comes from (requires Apple Developer enrollment — J-021):
#   APPLE_TEAM_ID            — Apple Developer portal → Membership → Team ID
#                             (10-char alphanumeric, e.g. ABCDEFGHIJ).
#   IOS_BUNDLE_ID           — already `gov.mt.fwp.engagemt` (matches
#                             capacitor.config.ts appId); leave as-is.
#   IOS_PROVISIONING_PROFILE — the distribution provisioning profile NAME from
#                             App Store Connect / Xcode (not the file path).
#
# Keep the key names in lockstep with the `: "${VAR:?}"` checks in
# mobile/scripts/release-ios.sh.

APPLE_TEAM_ID=ABCDEFGHIJ
IOS_BUNDLE_ID=gov.mt.fwp.engagemt
IOS_PROVISIONING_PROFILE=engagemt-distribution
